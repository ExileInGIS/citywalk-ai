# =====================================================================
# CityWalk AI · 环境变量示例
# 复制为 .env 后填写；.env 已被 .gitignore 排除，禁止提交真实密钥。
# 服务端启动时读取；前端拿不到这里的任何值。
# =====================================================================

# 服务端口
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------
# Agent 模式
#   mock   = 服务端本地确定性规划（默认，无需任何密钥）
#   remote = 调用真实大模型服务（需同时配置 LLM_* 或 COZE_*）
# ---------------------------------------------------------------------
AGENT_MODE=mock
AGENT_TIMEOUT_MS=18000
# 远程失败时：mock = 回退本地并标记 degraded；error = 直接返回错误
AGENT_FALLBACK=mock

# ---------------------------------------------------------------------
# 方案 A：OpenAI 兼容接口（OpenAI / DeepSeek / 通义 / 本地 vLLM 等）
# 注意：密钥只存在于服务端环境变量，不进入前端、不提交仓库。
# ---------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 例如：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ---------------------------------------------------------------------
# 方案 B：Coze（可选，未联调；接入前请按官方最新文档核对）
# ---------------------------------------------------------------------
COZE_API_TOKEN=
COZE_BOT_ID=
COZE_BASE_URL=https://api.coze.cn

# ---------------------------------------------------------------------
# 安全与可观测性
# ---------------------------------------------------------------------
RATE_LIMIT_PER_MIN=30
# 全站访问密码（HTTP Basic Auth）；SITE_PASSWORD 留空 = 不启用
# 设置后浏览器会弹出登录框；/api/health 仍保持公开供 Render 健康检查
SITE_USER=citywalk
SITE_PASSWORD=
# 允许跨域来源，逗号分隔；留空 = 只允许同源
CORS_ORIGINS=
LOG_LEVEL=info

# 是否启用匿名事件上报接口（true/false）
TELEMETRY_ENABLED=true

# ---------------------------------------------------------------------
# 真实地图（Leaflet + 高德栅格瓦片；非商用/自用）
#   MAP_PROVIDER=mock  = 离线示意地图（默认）
#   MAP_PROVIDER=amap  = Leaflet + 高德栅格底图（不需要 JS API Key）
#   AMAP_JS_KEY / AMAP_SECURITY_CODE 当前模式不使用，可留空
# ---------------------------------------------------------------------
MAP_PROVIDER=mock
AMAP_JS_KEY=
AMAP_SECURITY_CODE=
